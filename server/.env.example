# 复制为 .env 或直接 export
# app_plat 中创建 OAuth 应用后获得
PLATFORM_CLIENT_ID=your_client_id
PLATFORM_CLIENT_SECRET=your_client_secret

# 脑池 API Key —— 默认为 app_plat 的 dev 默认 key
PLATFORM_BRAIN_API_KEY=dev-key-2024

# brain-think 自家 JWT 签名密钥 (>=32 chars)
BT_JWT_SECRET=please-change-this-to-a-32-or-more-chars-secret

# app_plat 后端 base URL（默认本机直连）
PLATFORM_BASE_URL=https://api.local.caixy.xin/api

# PostgreSQL —— docker-compose 暴露的是 5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=appmarket
DB_USER=postgres
DB_PASSWORD=postgres
